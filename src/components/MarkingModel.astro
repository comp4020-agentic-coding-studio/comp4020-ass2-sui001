---
interface GradeBand {
  band: string;
  description: string;
}

interface WeightedMarking {
  mode: "weighted";
  criteria: { name: string; weight: number }[];
  bands?: GradeBand[];
}

interface HolisticMarking {
  mode: "holistic";
  description: string;
  bands?: GradeBand[];
}

interface Props {
  marking: WeightedMarking | HolisticMarking;
}

const { marking } = Astro.props;
---

<section aria-labelledby="how-marked">
  <h2 id="how-marked">How it is marked</h2>
  {marking.mode === "holistic" ? (
    <p>{marking.description}</p>
  ) : (
    <table>
      <thead><tr><th scope="col">Criterion</th><th scope="col">Weight</th></tr></thead>
      <tbody>
        {marking.criteria.map((criterion) => (
          <tr><td>{criterion.name}</td><td>{criterion.weight}%</td></tr>
        ))}
      </tbody>
    </table>
  )}
</section>

{marking.bands && (
  <section aria-labelledby="grade-bands">
    <h2 id="grade-bands">What separates the grades</h2>
    <p>
      Where the mark actually lands within a band is a judgement call; this
      is what tells the bands apart.
    </p>
    <table>
      <thead><tr><th scope="col">Band</th><th scope="col">What it looks like</th></tr></thead>
      <tbody>
        {marking.bands.map((band) => (
          <tr><td>{band.band}</td><td>{band.description}</td></tr>
        ))}
      </tbody>
    </table>
  </section>
)}
